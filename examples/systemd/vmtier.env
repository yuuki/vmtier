# Environment for examples/systemd/vmtier.service. Install as
# /etc/vmtier/vmtier.env with owner root and mode 0600; never commit real values.
AWS_ACCESS_KEY_ID=replace-with-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-secret-access-key
# AWS_SESSION_TOKEN=
# PostgreSQL catalog only: the variable named by catalog.dsn_env.
# VMTIER_POSTGRES_DSN=postgres://vmtier@db.example.internal:5432/vmtier?sslmode=verify-full
